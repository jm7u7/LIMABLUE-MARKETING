# === Variables de entorno (configúralas en Vercel → Project → Settings → Environment Variables) ===

# Postgres (Neon). Se inyecta SOLA cuando conectas la base de datos desde la pestaña Storage de Vercel.
# No la copies a mano; Vercel crea POSTGRES_URL y relacionadas automáticamente.
POSTGRES_URL=

# Clave secreta para firmar las sesiones. Pon una cadena larga y aleatoria.
# Genérala con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Cuenta administradora inicial (se crea sola la primera vez que se usa la BD).
# Cámbiala/bórrala después de crear tus usuarios reales.
ADMIN_EMAIL=sistemas@limablue.com
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME=Administrador
ADMIN_CARGO=gerente
